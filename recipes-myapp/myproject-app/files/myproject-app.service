[Unit]
Description=MyProject application service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/myproject-app
WorkingDirectory=/var/lib/myproject
Restart=always
RestartSec=5
StateDirectory=myproject
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes

[Install]
WantedBy=multi-user.target
