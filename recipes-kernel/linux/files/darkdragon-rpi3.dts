/dts-v1/;

/*
 * DarkDragon custom board derived from the Raspberry Pi 3 reference design.
 *
 * Practical rule for a project layer:
 * - reuse upstream SoC/family includes wherever possible
 * - keep only board-specific identity and wiring changes here
 * - move policy-heavy bootargs to Yocto or the bootloader when possible
 */
#include "bcm2710.dtsi"
#include "bcm2709-rpi.dtsi"
#include "bcm283x-rpi-smsc9514.dtsi"
#include "bcm283x-rpi-csi1-2lane.dtsi"
#include "bcm283x-rpi-i2c0mux_0_44.dtsi"
#include "bcm271x-rpi-bt.dtsi"

/ {
	model = "DarkDragon Raspberry Pi 3 Custom Board";
	compatible = "darkdragon,darkdragon-rpi3", "raspberrypi,3-model-b", "brcm,bcm2837";

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &uart1;
		serial1 = &uart0;
		mmc1 = &mmcnr;
	};
};

&firmware {
	/*
	 * Raspberry Pi 3 board glue expects a firmware-backed GPIO expander used
	 * for BT/Wi-Fi power and a few board control signals.
	 */
	expgpio: expgpio {
		compatible = "raspberrypi,firmware-gpio";
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "BT_ON",
				  "WL_ON",
				  "STATUS_LED",
				  "LAN_RUN",
				  "HDMI_HPD_N",
				  "CAM_GPIO0",
				  "CAM_GPIO1",
				  "PWR_LOW_N";
		status = "okay";
	};
};

&uart1 {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&bt {
	status = "okay";
	max-speed = <921600>;
};

&mmcnr {
	status = "okay";
};

&sdhost {
	status = "okay";
};
