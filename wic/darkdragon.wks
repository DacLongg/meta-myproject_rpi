# DarkDragon image layout owned by the project rather than inherited implicitly
# from the Raspberry Pi BSP defaults.
part /boot --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --active --align 4096 --size 64
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label root --align 4096
